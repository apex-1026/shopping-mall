<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qf.dao.UserDao">
    <select id="selectAll" resultType="com.qf.pojo.User">
        select * from user
    </select>
    <!-- 登录：根据用户名和密码查询用户 -->
    <select id="login" resultType="com.qf.pojo.User">
        select * from user where username = #{username} and password = #{password}
    </select>
    <!-- 注册：插入新用户 -->
    <insert id="register" parameterType="com.qf.pojo.User">
        insert into user (uid, username, password, avatar) values (#{uid}, #{username}, #{password}, #{avatar})
    </insert>
    <!-- 修改用户信息 -->
    <update id="updateUser" parameterType="com.qf.pojo.User">
        update user set username = #{username}, password = #{password}, avatar = #{avatar} where uid = #{uid}
    </update>
    <!-- 删除用户 -->
    <delete id="deleteUser" parameterType="String">
        delete from user where uid = #{uid}
    </delete>
    <!-- 根据用户名查询用户 -->
    <select id="findByUserName" resultType="com.qf.pojo.User">
        select * from user where username = #{username}
    </select>
    <!-- 根据UID查询用户 -->
    <select id="findByUid" resultType="com.qf.pojo.User">
        select * from user where uid = #{uid}
    </select>
</mapper>
